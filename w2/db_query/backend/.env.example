# LLM API Key for natural language to SQL conversion (OpenAI-compatible; e.g. DeepSeek)
LLM_API_KEY=sk-your-api-key-here

# Optional: OpenAI-compatible base URL (e.g. https://api.deepseek.com or https://api.deepseek.com/v1)
LLM_BASE_URL=

# Optional: model name (provider-specific)
LLM_MODEL=deepseek-chat

# Optional: Custom data directory (defaults to ~/.db_query)
DB_QUERY_DATA_DIR=~/.db_query

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# CORS origins (comma-separated, * for all)
CORS_ORIGINS=*
